# ==============================================================================
# [DEPLOYMENT - SEGURIDAD]: PLANTILLA DE VARIABLES DE ENTORNO
# Copia estas variables en el panel de tu proveedor de hosting (Azure, Render,
# Railway, AWS, Docker, etc.) para evitar exponer credenciales en el repositorio.
# En .NET, los niveles de configuración anidados se separan con doble guion bajo (__).
# ==============================================================================

# 1. Base de Datos (MySQL)
ConnectionStrings__DefaultConnection="server=TU_HOST_MYSQL;port=3306;user=TU_USUARIO;password=TU_PASSWORD;database=Inventory;sslmode=Required"

# 2. Seguridad JWT (La clave secreta debe tener al menos 32 caracteres / 256 bits)
Jwt__SecretKey="GENERA_UNA_CLAVE_SECRETA_LARGA_Y_SEGURA_AQUI_MINIMO_32_CARACTERES"
Jwt__Issuer="InventorySystemCloudApi"
Jwt__Audience="InventorySystemCloudApp"
Jwt__ExpirationMinutes=30
Jwt__RefreshTokenExpirationDays=7

# 3. Cloudinary (Almacenamiento de imágenes de productos y avatares)
CloudinarySettings__CloudName="TU_CLOUDINARY_CLOUD_NAME"
CloudinarySettings__ApiKey="TU_CLOUDINARY_API_KEY"
CloudinarySettings__ApiSecret="TU_CLOUDINARY_API_SECRET"

# 4. Correo Electrónico (Gmail SMTP / SendGrid)
EmailSettings__SmtpHost="smtp.gmail.com"
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser="tu-correo@gmail.com"
EmailSettings__SmtpPassword="tu-contraseña-de-aplicacion-gmail"
EmailSettings__SenderEmail="tu-correo@gmail.com"
EmailSettings__SenderName="InventorySystem Cloud"
EmailSettings__IsSimulationMode=false

# 5. Cuenta Administrador Inicial (Se crea automáticamente al iniciar la API)
InitialAdmin__Email="admin@tuempresa.com"
InitialAdmin__Password="TuPasswordAdminMuySegura2026!"

# 6. Cuenta Cajero Demo (Opcional - Útil para portafolios; para producción pon EnableDemoSeeding=false)
EnableDemoSeeding=true
DemoCashier__Email="cajero@inventorycloud.com"
DemoCashier__Password="CashierDemo123*!"
